{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Logic Only",
            "type": "debugpy",
            "request": "launch",
            "program": "src/plc/krax.py",
            "console": "integratedTerminal",
            "args": ["-w","${workspaceFolder}/src/plc"]
        },
        {
            "name": "Simulator",
            "type": "debugpy",
            "request": "launch",
            "module": "src.gui",
            "args": [
                "-w",
                "src/gui/data",
                "run",
                "--simulator"
            ]
        },
        {
            "name": "Runtime",
            "type": "debugpy",
            "request": "launch",
            "module": "src.gui",
            "args": [
                "-w",
                "src/gui/data",
                "run"
            ]
        }
    ]
}